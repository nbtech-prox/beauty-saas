{
  "name": "@beauty-saas/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Schemas Zod e tipos TS partilhados entre apps. Source of truth dos contratos.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tenant": {
      "types": "./dist/tenant.d.ts",
      "import": "./dist/tenant.js"
    },
    "./plan": {
      "types": "./dist/plan.d.ts",
      "import": "./dist/plan.js"
    },
    "./subscription": {
      "types": "./dist/subscription.d.ts",
      "import": "./dist/subscription.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.js"
    },
    "./common": {
      "types": "./dist/common.d.ts",
      "import": "./dist/common.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "echo 'lint placeholder (eslint config a definir)'"
  },
  "dependencies": {
    "zod": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "tsup": "^8.3.5",
    "typescript": "5.9.3",
    "vitest": "^2.1.8"
  }
}
