# ─────────────────────────────────────────────────────────────
# Joyce SaaS — variáveis de ambiente (template)
# ─────────────────────────────────────────────────────────────
# Copiar para .env.local e preencher. NUNCA commitar .env.local.

# ─── Plataforma ─────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://plataforma.local:3000
NEXT_PUBLIC_API_URL=http://api.joycehairbeauty.local:8000

# Subdomínio de wildcard (sem *. prefixo)
PLATFORM_WILDCARD_DOMAIN=plataforma.local
PLATFORM_ROOT_DOMAIN=plataforma.local

# ─── Data Plane (joycehairbeauty API) ───────────────────────
# Sanctum super-admin token OU credenciais de service account
DATA_PLANE_API_URL=http://api.joycehairbeauty.local:8000
DATA_PLANE_API_TOKEN=

# ─── Billing (Stripe) ────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_YEARLY=price_...

# ─── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=no-reply@plataforma.local

# ─── Observabilidade ─────────────────────────────────────────
SENTRY_DSN=
LOGTAIL_TOKEN=

# ─── Database (platform metadata) ───────────────────────────
# Apenas para dados do SaaS (tenants, subscriptions, audit)
# Runtime tenant-scoped; não usar para migrations
DATABASE_URL=
# Role de migrations distinta; não usar no runtime
DATABASE_MIGRATION_URL=

# ─── Auth ────────────────────────────────────────────────────
NEXTAUTH_SECRET=          # openssl rand -base64 32
NEXTAUTH_URL=http://plataforma.local:3000
